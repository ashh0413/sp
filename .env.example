# Database (required) - PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host:5432/split-spot"

# NextAuth (required) - Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# Optional: Prisma direct URL (for serverless connections)
# DATABASE_URL_NON_POOLING="postgresql://user:password@host:5432/split-spot?connection_limit=1&pool_timeout=10"
